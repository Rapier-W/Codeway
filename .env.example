# 本地开发模板；真实密钥通过环境变量或部署密钥管理注入，禁止提交仓库。
POSTGRES_USER=tongluxing
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=tongluxing
DATABASE_URL=postgresql://tongluxing:replace-with-local-password@localhost:5432/tongluxing?schema=public
PORT=3000
SKIP_DB_CONNECT=false

# 网站会话与允许来源；生产环境必须改为高熵随机值和 HTTPS 域名。
APP_ORIGIN=http://localhost:5173
SESSION_ACCESS_SECRET=replace-with-long-random-secret
SESSION_REFRESH_SECRET=replace-with-another-long-random-secret

# 七牛云短信：P0 只用于短信验证码，不用于自动 SOS 通知。
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=

# 七牛云 Kodo 私有桶。
KODO_BUCKET=
KODO_ACCESS_KEY=
KODO_SECRET_KEY=

# 高德：前端浏览器 Key 只能用于登记的域名；服务端 Key 不下发浏览器。
VITE_AMAP_BROWSER_KEY=
AMAP_SERVER_KEY=
