# ============================================================
# 生产环境变量示例（复制为 deploy/.env.prod 并填入真实值；切勿提交 .env.prod）
# 仅列出 API 实际读取的变量（见 apps/api/src 中 process.env.*）。
# 与 apps/api/.env.example 保持一致。
# ============================================================

# --- 数据库（容器内由 docker-compose.prod.yml 的 environment 用服务名 postgres 覆盖 host）---
POSTGRES_USER=tongluxing
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=tongluxing
DATABASE_URL=postgresql://tongluxing:CHANGE_ME_STRONG_PASSWORD@postgres:5432/tongluxing?schema=public

# --- API 基础 ---
PORT=3000
NODE_ENV=production
# 允许的来源（逗号分隔）；同域部署填公网 origin。生产必须 https。
CORS_ORIGINS=https://codeway.example.com

# --- 会话 Cookie（同域部署：Secure + SameSite=lax 即可）---
# 跨域（Web 与 API 不同源）时才需 COOKIE_SAME_SITE=none 并显式设置 COOKIE_DOMAIN。
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# --- 七牛云短信（仅用 QINIU_*；签名/模板在七牛控制台配置）---
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_SMS_TEMPLATE_ID=

# --- 七牛云 Kodo 订单截图私有桶（配齐 5 项才启用真实存储；否则生产 fail-closed）---
QINIU_KODO_BUCKET=
QINIU_KODO_UPLOAD_HOST=
QINIU_KODO_DOWNLOAD_HOST=
QINIU_KODO_ACCESS_KEY=
QINIU_KODO_SECRET_KEY=

# --- 高德（服务端 Key）---
AMAP_SERVER_KEY=

# --- 微信小程序登录 ---
WECHAT_APPID=
WECHAT_APP_SECRET=

# --- PostgreSQL 锁超时（状态事务快速失败为 503 RIDE_STATE_BUSY）---
POSTGRES_LOCK_TIMEOUT_MS=3000

# --- 禁止开启：仅无数据库 smoke 用，生产必须为 false ---
SKIP_DB_CONNECT=false
