# 强制以 LF 行尾提交，避免 Windows CRLF 破坏 shell 脚本 / Dockerfile / nginx 配置。
* text=auto

*.sh            text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf

*.md            text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.json          text eol=lf
*.html          text eol=lf
*.css          text eol=lf
