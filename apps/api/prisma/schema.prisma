// 同路行后端数据库基线（PostgreSQL）。
// 容量规则：Trip.capacity 只允许 3 或 4，且总人数包含发布者。
// Prisma schema 无法表达部分 CHECK 约束、状态/角色/席位与推荐理由白名单。
// 这些规则由 prisma/migrations/20260824190000_trip_domain_checks 与应用层共同强制。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  phone           String?  @unique
  phoneVerified   Boolean  @default(false) // 鏈畬鎴愭墜鏈哄彿楠岃瘉鍙兘娴忚
  studentVerified Boolean  @default(false) // 瀛︾敓璁よ瘉浠呬俊浠绘爣绛撅紝涓嶆嫤鎴?
  nickname        String?
  gender          String?
  creditScore     Int      @default(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdTrips            Trip[]                   @relation("TripCreator")
  memberships             TripMember[]
  confirmations           TripConfirmation[]
  sessions                Session[]
  chatMessages            ChatMessage[]
  farePlanConfirmations   FarePlanConfirmation[]
  farePlanChangeRequests  FarePlanChangeRequest[]
  farePlanChangeDecisions FarePlanChangeDecision[]

  @@map("users")
}

model Trip {
  id               String   @id @default(uuid())
  creatorId        String
  creator          User     @relation("TripCreator", fields: [creatorId], references: [id])
  origin           String
  destination      String
  departTime       DateTime
  capacity         Int // 鍙厑璁?3 鎴?4锛屾€讳汉鏁板惈鍙戝崟浜猴紱搴旂敤灞?+ SQL CHECK 寮哄埗
  feePlan          Json? // 閲戦涓€寰嬫暣鏁板垎
  initialFarePlan  Json? // 发布时的候选方案；成团后写入 immutable revision
  femaleOnly       Boolean  @default(false)
  status           String   @default("RECRUITING") // 鎷涘嫙涓?鈫?鍙屽悜纭涓?鈫?宸叉垚鍥?鈫?寰呭彨杞?鈫?宸插彨杞?鈫?琛岀▼缁撴潫寰呯粨绠?鈫?缁撶畻瀹屾垚 鈫?寰呰瘎浠?鈫?宸插綊妗?
  version          Int      @default(0) // 涔愯閿侊紝鐘舵€佸彉鏇村繀椤绘牎楠?
  disputeLocked    Boolean  @default(false)
  createRequestKey String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members                TripMember[]
  confirmations          TripConfirmation[]
  recommendations        RecommendationDecision[]
  rideRecords            RideRecord[]
  vehicleUpdates         VehicleUpdate[]
  fareOrders             FareOrder[]
  sosEvents              SosEvent[]
  reviews                Review[]
  reports                Report[]
  chatMessages           ChatMessage[]
  objectUploads          ObjectUpload[]
  farePlanRevisions      FarePlanRevision[]
  farePlanChangeRequests FarePlanChangeRequest[]

  @@index([departTime]) // 鍒楄〃鎸?depart_time ASC
  @@map("trips")
}

model ObjectUpload {
  id                String    @id @default(uuid())
  purpose           String
  provider          String
  objectKey         String    @unique @map("object_key")
  tripId            String    @map("trip_id")
  trip              Trip      @relation(fields: [tripId], references: [id])
  ownerId           String    @map("owner_id")
  allowedMimeType   String    @map("allowed_mime_type")
  declaredSizeBytes Int       @default(1) @map("declared_size_bytes")
  maxSizeBytes      Int       @map("max_size_bytes")
  requestKey        String    @unique @map("request_key")
  expiresAt         DateTime  @map("expires_at")
  claimedAt         DateTime? @map("claimed_at")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([expiresAt, claimedAt, deletedAt])
  @@map("object_uploads")
}

model TripMember {
  id             String   @id @default(uuid())
  tripId         String
  trip           Trip     @relation(fields: [tripId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  role           String   @default("MEMBER") // CREATOR | MEMBER
  memberCount    Int      @default(1) // 璇ユ垚鍛樺崰鐢ㄥ骇浣嶆暟锛氬彂鍗曚汉=1锛屽姞鍏ヨ€?1 鎴?2
  joinRequestKey String?  @unique // 瀹㈡埛绔姹傚箓绛夐敭
  joinedAt       DateTime @default(now())

  confirmations TripConfirmation[]

  @@unique([tripId, userId]) // 骞傜瓑锛氬悓涓€鐢ㄦ埛鍦ㄥ悓涓€琛岀▼鍙湁涓€鏉℃垚鍛樿褰?
  @@index([tripId, joinRequestKey])
  @@map("trip_members")
}

model TripConfirmation {
  id             String     @id @default(uuid())
  tripId         String
  trip           Trip       @relation(fields: [tripId], references: [id])
  memberId       String
  member         TripMember @relation(fields: [memberId], references: [id])
  userId         String
  user           User       @relation(fields: [userId], references: [id])
  status         String     @default("CONFIRMED") // CONFIRMED | VOID锛堝洖閫€浣滃簾锛夛紱userId 鍐椾綑瀛楁蹇呴』涓?member.userId 涓€鑷?
  confirmedAt    DateTime   @default(now())
  retractUntil   DateTime? // 鏈€鍚庝竴鍚嶆垚鍛樼‘璁ゅ紑鍚殑 15 绉掑弽鎮旂獥鍙?
  idempotencyKey String?    @unique // 閲嶅纭骞傜瓑
  createdAt      DateTime   @default(now())

  @@map("trip_confirmations")
}

model RecommendationDecision {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  reasons   String[] // SQL CHECK 寮哄埗鐧藉悕鍗曪細TIME_CLOSE | RELIABLE | VERIFIED | OPEN_SLOT锛屾渶澶?3 涓紝涓嶅奖鍝嶆帓搴?
  decidedAt DateTime @default(now())

  @@map("recommendation_decisions")
}

model AuditLog {
  id        String   @id @default(uuid())
  tripId    String?
  actorId   String?
  action    String // confirm | form-group | withdraw | rollback | duplicate-request 绛?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([tripId])
  @@map("audit_logs")
}

model RideRecord {
  id          String   @id @default(uuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id])
  requestedBy String
  platform    String
  mode        String   @default("MANUAL_FALLBACK")
  status      String   @default("WAITING_RIDE")
  requestKey  String?  @unique
  createdAt   DateTime @default(now())

  @@index([tripId])
}

model VehicleUpdate {
  id         String   @id @default(uuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id])
  updatedBy  String
  requestKey String?  @unique
  plate      String
  model      String?
  color      String?
  platform   String?
  createdAt  DateTime @default(now())

  @@index([tripId])
}

model FareOrder {
  id                  String                  @id @default(uuid())
  tripId              String                  @unique
  trip                Trip                    @relation(fields: [tripId], references: [id])
  submittedBy         String
  totalAmountCents    Int
  screenshotKey       String
  screenshotMimeType  String
  screenshotSizeBytes Int
  status              String                  @default("PENDING_CONFIRMATION") // PENDING_CONFIRMATION | CONFIRMED | DISPUTED | MANUAL_REVIEW
  createdAt           DateTime                @default(now())
  confirmedAt         DateTime?
  retentionDeleteAfter DateTime? @map("retention_delete_after")
  screenshotDeletedAt DateTime? @map("screenshot_deleted_at")
  updatedAt           DateTime                @updatedAt
  requestKey          String?                 @unique(map: "FareOrder_requestKey_key") @map("request_key")
  sourceUploadId      String?                 @unique(map: "FareOrder_sourceUploadId_key") @map("source_upload_id")
  disputes            FareDispute[]
  confirmations       FareOrderConfirmation[]
  paymentMarks        PaymentMark[]

  @@index([status])
  @@index([retentionDeleteAfter, screenshotDeletedAt])
}

model FarePlanRevision {
  id             String                  @id @default(uuid())
  tripId         String                  @map("trip_id")
  trip           Trip                    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sequence       Int
  plan           Json
  status         String                  @default("PENDING_CONFIRMATION")
  createdAt      DateTime                @default(now()) @map("created_at")
  lockedAt       DateTime?               @map("locked_at")
  supersededAt   DateTime?               @map("superseded_at")
  confirmations  FarePlanConfirmation[]
  changeRequests FarePlanChangeRequest[]

  @@unique([tripId, sequence])
  @@index([tripId, status])
  @@map("fare_plan_revisions")
}

model FarePlanConfirmation {
  id             String           @id @default(uuid())
  revisionId     String           @map("revision_id")
  revision       FarePlanRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  userId         String           @map("user_id")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String           @default("PENDING")
  idempotencyKey String?          @unique @map("idempotency_key")
  confirmedAt    DateTime?        @map("confirmed_at")
  voidedAt       DateTime?        @map("voided_at")

  @@unique([revisionId, userId])
  @@map("fare_plan_confirmations")
}

model FarePlanChangeRequest {
  id             String                   @id @default(uuid())
  tripId         String                   @map("trip_id")
  trip           Trip                     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  baseRevisionId String                   @map("base_revision_id")
  baseRevision   FarePlanRevision         @relation(fields: [baseRevisionId], references: [id])
  proposedPlan   Json                     @map("proposed_plan")
  reason         String?
  requestedBy    String                   @map("requested_by")
  requester      User                     @relation(fields: [requestedBy], references: [id], onDelete: Cascade)
  status         String                   @default("PENDING")
  requestKey     String                   @unique @map("request_key")
  expiresAt      DateTime                 @map("expires_at")
  appliedAt      DateTime?                @map("applied_at")
  createdAt      DateTime                 @default(now()) @map("created_at")
  decisions      FarePlanChangeDecision[]

  @@index([tripId, status])
  @@map("fare_plan_change_requests")
}

model FarePlanChangeDecision {
  id             String                @id @default(uuid())
  requestId      String                @map("request_id")
  request        FarePlanChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId         String                @map("user_id")
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision       String                @default("PENDING")
  decidedAt      DateTime?             @map("decided_at")
  idempotencyKey String?               @unique @map("idempotency_key")

  @@unique([requestId, userId])
  @@map("fare_plan_change_decisions")
}

// Keeps every accepted fare-plan idempotency key immutable, including a
// different retry key that reaches an already-terminal vote/confirmation.
model FarePlanIdempotencyKey {
  id                 String   @id @default(uuid())
  key                String   @unique @map("key")
  operation          String
  tripId             String   @map("trip_id")
  targetId           String   @map("target_id")
  userId             String   @map("user_id")
  requestFingerprint String   @map("request_fingerprint")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([tripId, userId])
  @@map("fare_plan_idempotency_keys")
}

model FareDispute {
  id          String    @id @default(uuid())
  fareOrderId String
  fareOrder   FareOrder @relation(fields: [fareOrderId], references: [id])
  raisedBy    String
  reason      String
  status      String    @default("OPEN")
  resolvedAt  DateTime? @map("resolved_at")
  resolution  String?
  createdAt   DateTime  @default(now())
}

model FareOrderConfirmation {
  id          String    @id @default(uuid())
  fareOrderId String
  fareOrder   FareOrder @relation(fields: [fareOrderId], references: [id])
  userId      String
  confirmedAt DateTime  @default(now())

  @@unique([fareOrderId, userId])
}

model PaymentMark {
  id          String    @id @default(uuid())
  fareOrderId String
  fareOrder   FareOrder @relation(fields: [fareOrderId], references: [id])
  userId      String
  amountCents Int?
  status      String    @default("MARKED")
  markedAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([fareOrderId, userId])
}

model EmergencyContact {
  id         String   @id @default(uuid())
  userId     String
  name       String
  phone      String
  active     Boolean  @default(true)
  requestKey String?  @unique
  createdAt  DateTime @default(now())

  @@index([userId])
}

model SosEvent {
  id         String   @id @default(uuid())
  tripId     String
  userId     String
  latitude   Float?
  longitude  Float?
  note       String?
  requestKey String?  @unique
  status     String   @default("RECORDED")
  createdAt  DateTime @default(now())
  trip       Trip     @relation(fields: [tripId], references: [id])

  @@index([tripId])
}

model NotificationEvent {
  id        String   @id @default(uuid())
  type      String
  tripId    String?
  userId    String?
  payload   Json
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@index([tripId])
}

model Review {
  id            String   @id @default(uuid())
  tripId        String
  trip          Trip     @relation(fields: [tripId], references: [id])
  reviewerId    String
  targetUserId  String
  punctuality   Int
  safety        Int
  politeness    Int
  communication Int
  comment       String?
  anonymous     Boolean  @default(false)
  requestKey    String?  @unique
  createdAt     DateTime @default(now())

  @@unique([tripId, reviewerId, targetUserId])
}

model Report {
  id           String   @id @default(uuid())
  tripId       String?
  trip         Trip?    @relation(fields: [tripId], references: [id])
  reporterId   String
  targetUserId String?
  type         String
  description  String
  evidenceKey  String?
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())

  @@index([tripId])
}

model AnalyticsEvent {
  id          String   @id @default(uuid())
  userId      String?
  eventKey    String
  eventType   String
  tripId      String?
  reasonCodes String[]
  ruleVersion String
  payload     Json
  createdAt   DateTime @default(now())

  @@unique([eventKey])
  @@index([tripId])
}

model SmsCode {
  id           String    @id @default(uuid())
  phone        String
  code         String
  status       String    @default("PENDING")
  requestIp    String?
  attemptCount Int       @default(0)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([phone])
  @@index([phone, status])
  @@map("sms_codes")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model ChatMessage {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  kind      String   @default("TEXT") // TEXT | CONFIRMATION_CARD
  text      String   @db.VarChar(500) // 文本长度上限，防止超长消息
  payload   Json? // 结构化确认卡片等附加数据
  clientKey String? // 客户端幂等键，重复发送返回首次结果
  createdAt DateTime @default(now())

  @@unique([tripId, clientKey]) // 幂等：同一行程内同一客户端键只落一条
  @@index([tripId, createdAt]) // 历史消息按时间分页
  @@map("chat_messages")
}
