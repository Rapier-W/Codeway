// 鍚岃矾琛屽悗绔暟鎹簱鍩虹嚎锛圥ostgreSQL锛?
// 瀹归噺瑙勫垯锛歍rip.capacity 鍙兘鏄?3 鎴?4锛屼笖鎬讳汉鏁板惈鍙戝崟浜恒€?
// Prisma schema 鏃犳硶琛ㄨ揪 CHECK 绾︽潫锛?|4銆佺姸鎬?瑙掕壊/甯綅鍜屾帹鑽愮悊鐢辨牎楠?
// 鍦ㄥ簲鐢ㄥ眰涓?prisma/migrations/20260824190000_trip_domain_checks 涓叡鍚屽己鍒躲€?

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  phone           String?  @unique
  phoneVerified   Boolean  @default(false) // 鏈畬鎴愭墜鏈哄彿楠岃瘉鍙兘娴忚
  studentVerified Boolean  @default(false) // 瀛︾敓璁よ瘉浠呬俊浠绘爣绛撅紝涓嶆嫤鎴?
  nickname        String?
  gender          String?
  creditScore     Int      @default(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdTrips  Trip[]             @relation("TripCreator")
  memberships   TripMember[]
  confirmations TripConfirmation[]
  sessions      Session[]
  chatMessages  ChatMessage[]

  @@map("users")
}

model Trip {
  id          String   @id @default(uuid())
  creatorId   String
  creator     User     @relation("TripCreator", fields: [creatorId], references: [id])
  origin      String
  destination String
  departTime  DateTime
  capacity    Int // 鍙厑璁?3 鎴?4锛屾€讳汉鏁板惈鍙戝崟浜猴紱搴旂敤灞?+ SQL CHECK 寮哄埗
  feePlan     Json? // 閲戦涓€寰嬫暣鏁板垎
  femaleOnly  Boolean  @default(false)
  status      String   @default("RECRUITING") // 鎷涘嫙涓?鈫?鍙屽悜纭涓?鈫?宸叉垚鍥?鈫?寰呭彨杞?鈫?宸插彨杞?鈫?琛岀▼缁撴潫寰呯粨绠?鈫?缁撶畻瀹屾垚 鈫?寰呰瘎浠?鈫?宸插綊妗?
  version     Int      @default(0) // 涔愯閿侊紝鐘舵€佸彉鏇村繀椤绘牎楠?
  disputeLocked Boolean @default(false)
  createRequestKey String? @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members         TripMember[]
  confirmations   TripConfirmation[]
  recommendations RecommendationDecision[]
  rideRecords     RideRecord[]
  vehicleUpdates  VehicleUpdate[]
  fareOrders      FareOrder[]
  sosEvents       SosEvent[]
  reviews         Review[]
  reports         Report[]
  chatMessages    ChatMessage[]
  objectUploads   ObjectUpload[]

  @@index([departTime]) // 鍒楄〃鎸?depart_time ASC
  @@map("trips")
}

model ObjectUpload {
  id              String    @id @default(uuid())
  purpose         String
  provider        String
  objectKey       String    @unique @map("object_key")
  tripId          String    @map("trip_id")
  trip            Trip      @relation(fields: [tripId], references: [id])
  ownerId         String    @map("owner_id")
  allowedMimeType String    @map("allowed_mime_type")
  declaredSizeBytes Int     @map("declared_size_bytes")
  maxSizeBytes    Int       @map("max_size_bytes")
  requestKey      String    @unique @map("request_key")
  expiresAt       DateTime  @map("expires_at")
  claimedAt       DateTime? @map("claimed_at")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([expiresAt, claimedAt, deletedAt])
  @@map("object_uploads")
}

model TripMember {
  id          String   @id @default(uuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  role        String   @default("MEMBER") // CREATOR | MEMBER
  memberCount Int      @default(1) // 璇ユ垚鍛樺崰鐢ㄥ骇浣嶆暟锛氬彂鍗曚汉=1锛屽姞鍏ヨ€?1 鎴?2
  joinRequestKey String? @unique // 瀹㈡埛绔姹傚箓绛夐敭
  joinedAt    DateTime @default(now())

  confirmations TripConfirmation[]

  @@unique([tripId, userId]) // 骞傜瓑锛氬悓涓€鐢ㄦ埛鍦ㄥ悓涓€琛岀▼鍙湁涓€鏉℃垚鍛樿褰?
  @@index([tripId, joinRequestKey])
  @@map("trip_members")
}

model TripConfirmation {
  id             String      @id @default(uuid())
  tripId         String
  trip           Trip        @relation(fields: [tripId], references: [id])
  memberId       String
  member         TripMember  @relation(fields: [memberId], references: [id])
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  status         String      @default("CONFIRMED") // CONFIRMED | VOID锛堝洖閫€浣滃簾锛夛紱userId 鍐椾綑瀛楁蹇呴』涓?member.userId 涓€鑷?
  confirmedAt    DateTime    @default(now())
  retractUntil   DateTime? // 鏈€鍚庝竴鍚嶆垚鍛樼‘璁ゅ紑鍚殑 15 绉掑弽鎮旂獥鍙?
  idempotencyKey String?     @unique // 閲嶅纭骞傜瓑
  createdAt      DateTime    @default(now())

  @@map("trip_confirmations")
}

model RecommendationDecision {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  reasons   String[] // SQL CHECK 寮哄埗鐧藉悕鍗曪細TIME_CLOSE | RELIABLE | VERIFIED | OPEN_SLOT锛屾渶澶?3 涓紝涓嶅奖鍝嶆帓搴?
  decidedAt DateTime @default(now())

  @@map("recommendation_decisions")
}

model AuditLog {
  id        String   @id @default(uuid())
  tripId    String?
  actorId   String?
  action    String // confirm | form-group | withdraw | rollback | duplicate-request 绛?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([tripId])
  @@map("audit_logs")
}

model RideRecord {
  id          String   @id @default(uuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id])
  requestedBy String
  platform    String
  mode        String   @default("MANUAL_FALLBACK")
  status      String   @default("WAITING_RIDE")
  requestKey   String?  @unique
  createdAt   DateTime @default(now())
  @@index([tripId])
}

model VehicleUpdate {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  updatedBy String
  requestKey String? @unique
  plate     String
  model     String?
  color     String?
  platform  String?
  createdAt DateTime @default(now())
  @@index([tripId])
}

model FareOrder {
  id                   String   @id @default(uuid())
  tripId               String   @unique
  trip                 Trip     @relation(fields: [tripId], references: [id])
  submittedBy          String
  totalAmountCents     Int
  screenshotKey        String
  screenshotMimeType   String
  screenshotSizeBytes  Int
  status               String   @default("PENDING_CONFIRMATION") // PENDING_CONFIRMATION | CONFIRMED | DISPUTED | MANUAL_REVIEW
  createdAt            DateTime @default(now())
  confirmedAt          DateTime?
  updatedAt            DateTime @updatedAt
  requestKey           String?  @unique @map("request_key")
  sourceUploadId       String?  @unique @map("source_upload_id")
  disputes             FareDispute[]
  confirmations        FareOrderConfirmation[]
  paymentMarks         PaymentMark[]
  @@index([status])
}

model FareDispute {
  id          String   @id @default(uuid())
  fareOrderId String
  fareOrder   FareOrder @relation(fields: [fareOrderId], references: [id])
  raisedBy    String
  reason      String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
}

model FareOrderConfirmation {
  id          String   @id @default(uuid())
  fareOrderId String
  fareOrder   FareOrder @relation(fields: [fareOrderId], references: [id])
  userId      String
  confirmedAt DateTime @default(now())
  @@unique([fareOrderId, userId])
}

model PaymentMark {
  id          String   @id @default(uuid())
  fareOrderId String
  fareOrder   FareOrder @relation(fields: [fareOrderId], references: [id])
  userId      String
  amountCents Int?
  status      String   @default("MARKED")
  markedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([fareOrderId, userId])
}

model EmergencyContact {
  id        String   @id @default(uuid())
  userId    String
  name      String
  phone     String
  active    Boolean  @default(true)
  requestKey String? @unique
  createdAt DateTime @default(now())
  @@index([userId])
}

model SosEvent {
  id        String   @id @default(uuid())
  tripId    String
  userId    String
  latitude  Float?
  longitude Float?
  note      String?
  requestKey String? @unique
  status    String   @default("RECORDED")
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id])
  @@index([tripId])
}

model NotificationEvent {
  id        String   @id @default(uuid())
  type      String
  tripId    String?
  userId    String?
  payload   Json
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  @@index([tripId])
}

model Review {
  id            String   @id @default(uuid())
  tripId        String
  trip          Trip     @relation(fields: [tripId], references: [id])
  reviewerId    String
  targetUserId  String
  punctuality   Int
  safety        Int
  politeness    Int
  communication Int
  comment       String?
  anonymous     Boolean  @default(false)
  requestKey    String?  @unique
  createdAt     DateTime @default(now())
  @@unique([tripId, reviewerId, targetUserId])
}

model Report {
  id           String   @id @default(uuid())
  tripId       String?
  trip          Trip?   @relation(fields: [tripId], references: [id])
  reporterId    String
  targetUserId  String?
  type          String
  description   String
  evidenceKey   String?
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())
  @@index([tripId])
}

model AnalyticsEvent {
  id           String   @id @default(uuid())
  userId       String?
  eventKey     String
  eventType    String
  tripId       String?
  reasonCodes  String[]
  ruleVersion  String
  payload      Json
  createdAt    DateTime @default(now())
  @@unique([eventKey])
  @@index([tripId])
}

model SmsCode {
  id           String    @id @default(uuid())
  phone        String
  code         String
  status       String    @default("PENDING")
  requestIp    String?
  attemptCount Int       @default(0)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([phone])
  @@index([phone, status])
  @@map("sms_codes")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model ChatMessage {
  id          String   @id @default(uuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id])
  senderId    String
  sender      User     @relation(fields: [senderId], references: [id])
  kind        String   @default("TEXT") // TEXT | CONFIRMATION_CARD
  text        String   @db.VarChar(500) // 文本长度上限，防止超长消息
  payload     Json? // 结构化确认卡片等附加数据
  clientKey   String? // 客户端幂等键，重复发送返回首次结果
  createdAt   DateTime @default(now())

  @@unique([tripId, clientKey]) // 幂等：同一行程内同一客户端键只落一条
  @@index([tripId, createdAt]) // 历史消息按时间分页
  @@map("chat_messages")
}
