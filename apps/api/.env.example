# Copy to apps/api/.env for local Prisma CLI commands. Do not commit real secrets.
DATABASE_URL=postgresql://tongluxing:replace-with-local-password@localhost:5433/tongluxing?schema=public
E2E_DATABASE_URL=postgresql://tongluxing:replace-with-local-password@localhost:5433/tongluxing_e2e?schema=public
PORT=3000

# CORS：允许的来源（逗号分隔）。生产填公网 https origin。
CORS_ORIGINS=http://localhost:5173

# 会话 Cookie（阶段 9 新增，支持环境变量调优）：
# 同域部署保持 lax；跨域（Web/API 不同源）才需 none 并显式设置 COOKIE_DOMAIN。
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Qiniu Cloud SMS (leave blank for development console fallback only)
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_SMS_TEMPLATE_ID=

# Private Kodo fare screenshot storage (leave blank locally; never commit actual values)
QINIU_KODO_BUCKET=
QINIU_KODO_UPLOAD_HOST=
QINIU_KODO_DOWNLOAD_HOST=
QINIU_KODO_ACCESS_KEY=
QINIU_KODO_SECRET_KEY=

AMAP_SERVER_KEY=

# PostgreSQL lock timeout for state transactions (ms). Short timeout lets lock contention fail fast as 503 RIDE_STATE_BUSY.
POSTGRES_LOCK_TIMEOUT_MS=3000

# WeChat Mini Program login (wx.login → jscode2session). Get from mp.weixin.qq.com 开发设置.
WECHAT_APPID=
WECHAT_APP_SECRET=

# Qiniu Kodo object storage for fare screenshots. Get from portal.qiniu.com 对象存储.
QINIU_KODO_BUCKET=
QINIU_KODO_UPLOAD_HOST=
QINIU_KODO_DOWNLOAD_HOST=
QINIU_KODO_ACCESS_KEY=
QINIU_KODO_SECRET_KEY=
