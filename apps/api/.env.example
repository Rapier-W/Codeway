# Copy to apps/api/.env for local Prisma CLI commands. Do not commit real secrets.
DATABASE_URL=postgresql://tongluxing:replace-with-local-password@localhost:5433/tongluxing?schema=public
E2E_DATABASE_URL=postgresql://tongluxing:replace-with-local-password@localhost:5433/tongluxing_e2e?schema=public
PORT=3000

# Qiniu Cloud SMS (leave blank for development console fallback only)
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_SMS_TEMPLATE_ID=

# Private Kodo fare screenshot storage (leave blank locally; never commit actual values)
QINIU_KODO_BUCKET=
QINIU_KODO_UPLOAD_HOST=
QINIU_KODO_DOWNLOAD_HOST=
QINIU_KODO_ACCESS_KEY=
QINIU_KODO_SECRET_KEY=

AMAP_SERVER_KEY=
